msgid "Format"
msgstr "형식"

#: ../../usage.rst:57 2fa3185209b849d1a0b7d5ef6a28c6a3
msgid "Created by"
msgstr "생성 도구"

#: ../../usage.rst:58 8a70b6f3bc1d4998bcc33c24287ec158
msgid "``otp``"
msgstr "``otp``"

#: ../../usage.rst:59 c6560d5a3b9f4052bd32ad0b51abeffe
msgid "``otpauth://totp/...?secret=BASE32SECRET``"
msgstr "``otpauth://totp/...?secret=BASE32SECRET``"

#: ../../usage.rst:60 0bdc2d2be2f44b2f9eb3df3d617a5517
msgid "KeePassXC"
msgstr "KeePassXC"

#: ../../usage.rst:61 36e141f5f4f04673a520cd339017ea7f
